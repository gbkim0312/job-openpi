# Images built locally (or replace with a registry image reference)
BACKEND_IMAGE=job-collector-backend:local
DASHBOARD_IMAGE=job-collector-dashboard:local

APP_NAME=job-collector
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO
TZ=Asia/Seoul

POSTGRES_DB=job_collector
POSTGRES_USER=job_collector
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql+asyncpg://job_collector:replace-with-a-strong-db-password@postgres:5432/job_collector

# Generate a long random value; never commit the real key.
ADMIN_API_KEY=replace-with-a-long-random-secret

WANTED_ENABLED=true
WANTED_BASE_URL=https://www.wanted.co.kr
WANTED_REQUEST_DELAY_SECONDS=1.5
REQUEST_RANDOM_DELAY_ENABLED=false
REQUEST_RANDOM_DELAY_MAX_SECONDS=0.5
TOR_ENABLED=false
TOR_SOCKS_PROXY_URL=socks5://tor:9050
TOR_CONTROL_ENABLED=false
TOR_CONTROL_HOST=tor
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
WANTED_MAX_CONCURRENCY=2
SARAMIN_ENABLED=false
SARAMIN_ACCESS_KEY=
SARAMIN_BASE_URL=https://oapi.saramin.co.kr
SARAMIN_PUBLIC_ENABLED=false
SARAMIN_PUBLIC_BASE_URL=https://www.saramin.co.kr
SARAMIN_PUBLIC_REQUEST_DELAY_SECONDS=1.5
JOBKOREA_ENABLED=false
JOBKOREA_BASE_URL=https://www.jobkorea.co.kr
JOBKOREA_REQUEST_DELAY_SECONDS=1.5
SAMSUNG_ENABLED=false
LG_ENABLED=false
HYUNDAI_ENABLED=false

HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
SCHEDULER_ENABLED=false
SYNC_CRON=0 2 * * *
RECHECK_CRON=0 3 * * *
DEFAULT_PROFILE=mobility_sdv_security_cpp

DASHBOARD_PORT=8080
# Host port for direct OpenAPI access; the container itself keeps port 8000.
API_EXTERNAL_PORT=18000
CORS_ORIGINS=http://localhost:8080
